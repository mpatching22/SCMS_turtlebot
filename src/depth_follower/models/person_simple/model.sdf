<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="person_simple">
    <static>true</static>
    <!-- Rotate person 90° to face robot and lower slightly -->
    <pose>0 0 -0.25 0 0 1.57</pose>

    <!-- Torso (hi-viz orange box) -->
    <link name="torso">
      <pose>0 0 0.9 0 0 0</pose>
      <visual name="torso_visual">
        <geometry>
          <box>
            <size>0.3 0.2 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.4 0.0 1</ambient>
          <diffuse>1.0 0.4 0.0 1</diffuse>
        </material>
      </visual>
      <collision name="torso_collision">
        <geometry>
          <box>
            <size>0.3 0.2 0.5</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Head -->
    <link name="head">
      <pose>0 0 1.25 0 0 0</pose>
      <visual name="head_visual">
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="head_collision">
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <!-- Left leg -->
    <link name="leg_left">
      <pose>0.07 0 0.5 0 0 0</pose>
      <visual name="leg_left_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
      <collision name="leg_left_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right leg -->
    <link name="leg_right">
      <pose>-0.07 0 0.5 0 0 0</pose>
      <visual name="leg_right_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
      <collision name="leg_right_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.5</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Left arm -->
    <link name="arm_left">
      <pose>0.25 0 0.9 0 0 1.57</pose>
      <visual name="arm_left_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="arm_left_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right arm -->
    <link name="arm_right">
      <pose>-0.25 0 0.9 0 0 1.57</pose>
      <visual name="arm_right_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <collision name="arm_right_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.4</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

  </model>
</sdf>

