Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true

    - Class: rviz_default_plugins/Image
      Name: DepthImage
      Enabled: true
      Image Topic: /camera/depth_camera_sensor/depth/image_raw
      Queue Size: 10
      Transport Hint: raw

  Global Options:
    Fixed Frame: odom
    Frame Rate: 30

ViewManager:
  Class: rviz_default_plugins/Orbit
  Target Frame: odom
  Distance: 3.0
  Pitch: 0.5
  Yaw: 0.0

